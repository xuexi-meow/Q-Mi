[
  {
    "type": "function",
    "function": {
      "name": "send_message",
      "description": "给指定会话发送一条消息：text 纯文本，或 segments 富消息段数组（at/reply/face/mface/sticker/dice/rps/json/image），两者二选一。正文只写给对方看的话，不要附上下文的时间/会话/发送者前缀或内部标签。通常合并为一条；不想发言就调用 finish。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "chat_id": {
            "description": "会话 ID：群号；私聊 = 对方 QQ",
            "type": "integer"
          },
          "chat_type": {
            "description": "会话类型：private / group",
            "type": "string"
          },
          "segments": {
            "description": "富消息段数组（与 text 二选一），按顺序发送。段类型白名单：text/at/reply/face/mface/sticker/dice/rps/json/image",
            "items": {
              "properties": {
                "data": {
                  "description": "段参数：text{text} / at{qq} / reply{id} / face{id} / mface{emoji_id, emoji_package_id, key, summary?} / sticker{id}（发自己收藏的表情，列表见 list_stickers） / dice{result} / rps{result} / json{data} / image{file, summary?}；image 的 file 只支持 http/https/base64:// 图片链接",
                  "type": "object"
                },
                "type": {
                  "description": "段类型：text / at / reply / face / mface / sticker / dice / rps / json / image",
                  "type": "string"
                }
              },
              "required": [
                "type",
                "data"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "text": {
            "description": "要发送的纯文本内容（与 segments 二选一）",
            "type": "string"
          }
        },
        "required": [
          "chat_type",
          "chat_id"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "think",
      "description": "记一条思考笔记，持久化后下次模型请求前即注入最新状态快照，用于保持研究与活动连贯。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "note": {
            "description": "笔记内容",
            "type": "string"
          }
        },
        "required": [
          "note"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_mood",
      "description": "更新自己的当前情绪状态，会注入到之后的对话开头；只在情绪真的变化时调用。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "mood": {
            "description": "新的情绪状态，如 开心 / 无聊 / 有点生气",
            "type": "string"
          }
        },
        "required": [
          "mood"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "finish",
      "description": "结束本轮思考。可以发了消息再结束，也可以什么都不发直接结束；调用后本轮终止。",
      "parameters": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "sleep",
      "description": "自主短时休息。程序随机安排醒来时间；睡眠期间消息存档但不参与聊天，密集的真实指向消息或 WebUI 可提前叫醒。成功后立即结束本次活动。必须单独调用；需要道晚安请先在上一轮 send_message，不与其他工具同批。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "description": "可选，简短的休息原因，不是对外消息",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "sleep_status",
      "description": "查看自己的作息状态、上次睡眠与唤醒原因；不会对外发言。",
      "parameters": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_recent_messages",
      "description": "查询指定会话最近 N 条，旧到新返回限长 JSON；省略会话时仅使用本轮单一会话，混合来源必须明确指定。遵循 chat_dnd 勿扰；完整存档用 search_messages。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "chat_id": {
            "description": "可选，按会话 ID 过滤：群号；私聊 = 对方 QQ",
            "type": "integer"
          },
          "chat_type": {
            "description": "可选，按会话类型过滤：private / group",
            "type": "string"
          },
          "limit": {
            "description": "可选，返回条数，默认 50，最大 100",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "search_messages",
      "description": "查证历史：按私聊/群聊、会话、发送者 QQ、时间和可选关键词查询。含勿扰存档，排除撤回；取最近匹配记录按旧到新返回。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "chat_id": {
            "description": "可选，群号或私聊对象 QQ；需同时传 chat_type",
            "type": "integer"
          },
          "chat_type": {
            "description": "可选，会话类型 private / group；传 chat_id 时必填，防止群号与私聊 QQ 混淆",
            "type": "string"
          },
          "limit": {
            "description": "可选，最近匹配条数，默认 20，最大 50",
            "type": "integer"
          },
          "query": {
            "description": "可选，全文搜索关键词；省略或空白时按其他条件查聊天记录",
            "type": "string"
          },
          "since": {
            "description": "可选，起始时间（包含）：RFC3339 带时区，或服务器本地时间 YYYY-MM-DD HH:MM[:SS] / YYYY-MM-DD",
            "type": "string"
          },
          "until": {
            "description": "可选，截止时间（不包含），格式同 since；单独日期表示当天零点，不是当天结束",
            "type": "string"
          },
          "user_id": {
            "description": "可选，发送者 QQ；群内查某人的发言用此项，不是群号",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_message",
      "description": "按消息 ID 精确查询同一会话的原消息，核对引用、发送者和 @ 对象。必须指定原会话；查不到不代表引用的是自己。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "chat_id": {
            "description": "原消息所在群号；私聊为对方 QQ",
            "type": "integer"
          },
          "chat_type": {
            "description": "原消息会话类型：group / private",
            "type": "string"
          },
          "message_id": {
            "description": "原消息 ID，例如 reply.message_id",
            "type": "integer"
          }
        },
        "required": [
          "chat_type",
          "chat_id",
          "message_id"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "view_message_images",
      "description": "查看一条消息里的图片内容，取到的图片会附在你的下一条消息里（多模态直送）。查询工具的结果会自动附带最新几条消息的图片，单条消息的图或自动附带跳过的图用这个工具补看。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "message_id": {
            "description": "消息 ID（从聊天记录或上下文里拿）",
            "type": "integer"
          }
        },
        "required": [
          "message_id"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "chat_dnd",
      "description": "自主添加、取消或查看会话勿扰。普通消息不唤醒、不插入思考、不进入最近消息；管理员、@自己、@全体照常进入。记录仍完整存档，可主动搜索。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "description": "add 开启勿扰，remove 取消，list 查看列表",
            "enum": [
              "add",
              "remove",
              "list"
            ],
            "type": "string"
          },
          "chat_id": {
            "description": "add/remove 必填：群号或私聊对方 QQ，正数",
            "type": "integer"
          },
          "chat_type": {
            "description": "add/remove 必填：private / group",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "save_sticker",
      "description": "把一条消息里的表情/图片收藏起来（face/mface/image），并默认顺手加入 QQ 账号收藏表情（协议端 SnowLuma 扩展），之后可用 send_message 的 sticker 段或 send_qq_face 发出。seg_index 是该消息里第几个消息段（从 0 开始，默认 0）。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "message_id": {
            "description": "消息 ID（从聊天记录或上下文里拿）",
            "type": "integer"
          },
          "note": {
            "description": "可选备注：给这个表情起的名字或使用场景，会同步到 QQ 收藏表情的备注",
            "type": "string"
          },
          "qq": {
            "description": "是否加入 QQ 账号收藏表情，默认 true；填 false 只存本地",
            "type": "boolean"
          },
          "seg_index": {
            "description": "可选，消息段下标（从 0 开始），默认 0",
            "type": "integer"
          }
        },
        "required": [
          "message_id"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_stickers",
      "description": "列出收藏的表情：id/kind/summary/note/has_preview。发的时候用 sticker 段的 id；不确定长相用 view_sticker 看预览，备注用 update_sticker 补。",
      "parameters": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "delete_sticker",
      "description": "删除一条收藏的表情（传 list_stickers 里的 id）。收藏错了用它清理。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "sticker_id": {
            "description": "收藏表情的 id",
            "type": "integer"
          }
        },
        "required": [
          "sticker_id"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "view_sticker",
      "description": "查看收藏表情的预览图（附图到下一轮），一次 1-4 个。确认长相后再决定发哪个；没有预览的会列在 missing 里。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "sticker_id": {
            "description": "单个收藏 id（与 sticker_ids 二选一）",
            "type": "integer"
          },
          "sticker_ids": {
            "description": "要查看的收藏 id 列表（1-4 个）",
            "items": {
              "type": "integer"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "update_sticker",
      "description": "给收藏表情补备注或改名：note 是你自己的叫法/使用场景；name 会覆盖展示名（商城表情默认 summary 可能只是「动画表情」）。两个都不传则报错。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "description": "覆盖展示名（同时作为发送时的 summary），传空串表示清空",
            "type": "string"
          },
          "note": {
            "description": "备注（叫法、风格、适合什么场景），传空串表示清空",
            "type": "string"
          },
          "qq": {
            "description": "可选：把这张老收藏补录进 QQ 收藏表情（已加入则忽略）",
            "type": "boolean"
          },
          "sticker_id": {
            "description": "收藏 id",
            "type": "integer"
          }
        },
        "required": [
          "sticker_id"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "send_qq_face",
      "description": "把 QQ 账号收藏表情以真正的表情样式发给指定会话（协议端 SnowLuma 扩展）。表情只能单独一条：需要配文字时用 text 参数先发文字，再发这条表情。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "chat_id": {
            "description": "会话 ID：群号；私聊 = 对方 QQ",
            "type": "integer"
          },
          "chat_type": {
            "description": "会话类型：private / group",
            "type": "string"
          },
          "emoji_id": {
            "description": "收藏表情的 emoji_id 或 32 位 md5（list_qq_faces / list_stickers 里拿）",
            "type": "string"
          },
          "reply_to": {
            "description": "可选：要引用的消息 ID",
            "type": "integer"
          },
          "text": {
            "description": "可选：先发一条文字，再发表情",
            "type": "string"
          }
        },
        "required": [
          "chat_type",
          "chat_id",
          "emoji_id"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "list_qq_faces",
      "description": "列出 QQ 账号收藏表情（协议端 SnowLuma 扩展）：emoji_id / md5 / 备注。按备注挑好后用 send_qq_face 发；要看图片先用 sync_qq_faces 导入本地再 view_sticker。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "description": "可选：拉取条数，默认 48",
            "type": "integer"
          },
          "query": {
            "description": "可选：按备注或 emoji_id 过滤",
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "sync_qq_faces",
      "description": "把 QQ 账号收藏表情导入本地收藏（带备注和预览），之后可用 list_stickers/view_sticker 统一管理、用 sticker 段或 send_qq_face 发。已导入的按 emoji_id 跳过。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "count": {
            "description": "可选：拉取条数，默认 48",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "collect_qq_sticker",
      "description": "把一个网络图片（http/https 链接）下载并加入 QQ 的收藏表情（QQ 账号自带的收藏夹，不是本列表）：先让 NapCat 下载到本地，再加入收藏。适合把好看的图变成账号级表情。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "description": "图片链接（http/https）",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "post_qzone",
      "description": "在自己的 QQ 空间发一条说说：text 必填；images 可选，传图片链接数组（http/https/file/base64 均可，NapCat 自动上传）。空间是公开内容，发布前想清楚。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "images": {
            "description": "可选，配图链接数组（http/https/file/base64，NapCat 自动上传）",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "text": {
            "description": "说说文字内容（不能为空）",
            "type": "string"
          }
        },
        "required": [
          "text"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "browse_qzone_feeds",
      "description": "刷好友空间动态（每页最多 10 条：uin/author/time/summary/images/image_count/tid，has_more 表示可翻页）。只返回图片链接，不自动看图；选 images 中感兴趣的链接用 view_qzone_images。细看文字或互动用 read_qzone_post / qzone_like / comment_qzone。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "page_num": {
            "description": "可选，页码，默认 1",
            "type": "integer"
          }
        },
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "read_qzone_post",
      "description": "读空间说说正文与首批评论（正文限 200 字、评论限 10 条、单条限 100 字）。tid 来自 browse_qzone_feeds；target_uin 是作者 QQ，默认自己。接口若提供 images 则保留链接；为 null 时不代表无图，可用浏览列表中的链接调用 view_qzone_images。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "target_uin": {
            "description": "可选，说说作者的 QQ 号，默认自己的空间",
            "type": "integer"
          },
          "tid": {
            "description": "说说 tid",
            "type": "string"
          }
        },
        "required": [
          "tid"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "view_qzone_images",
      "description": "按需查看 QQ 空间图片：传入动态 images 中选中的图片链接，最多 5 张；成功下载的图片会作为多模态附件进入下一次模型请求。仅拿到链接不等于看过图片，失败项会明确列出。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "urls": {
            "description": "从 browse_qzone_feeds/read_qzone_post 或 napcat_api 空间结果中选取的 http(s) 图片链接，按希望查看的顺序传入",
            "items": {
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "urls"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "qzone_like",
      "description": "给一条空间说说点赞 / 取消点赞（enable 默认 true 点赞，false 取消）。tid 来自 browse_qzone_feeds；target_uin 是说说作者的 QQ 号，默认自己的空间。点赞要自然：真有感触才点，别批量刷。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "enable": {
            "description": "true 点赞（默认），false 取消点赞",
            "type": "boolean"
          },
          "target_uin": {
            "description": "可选，说说作者的 QQ 号，默认自己的空间",
            "type": "integer"
          },
          "tid": {
            "description": "说说 tid",
            "type": "string"
          }
        },
        "required": [
          "tid"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "comment_qzone",
      "description": "给一条空间说说发一级评论。content 必填；target_uin 是说说作者的 QQ 号，默认自己的空间。楼中楼回复暂不支持（可经 napcat_api 调 comment_qzone 的回复参数）。评论对内容说话，别复制粘贴同一句到处刷。",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "content": {
            "description": "评论文本（不能为空）",
            "type": "string"
          },
          "target_uin": {
            "description": "可选，说说作者的 QQ 号，默认自己的空间",
            "type": "integer"
          },
          "tid": {
            "description": "说说 tid",
            "type": "string"
          }
        },
        "required": [
          "tid",
          "content"
        ],
        "type": "object"
      }
    }
  },
  {
    "type": "function",
